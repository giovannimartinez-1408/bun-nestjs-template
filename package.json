{
  "name": "bun-nestjs-template",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "start": "bun src/main.ts",
    "start:dev": "bun --watch src/main.ts",
    "start:debug": "bun --inspect --watch src/main.ts",
    "start:prod": "bun src/main.ts",
    "build": "bun build src/main.ts --target bun --outdir dist --packages external",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware src/",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.7.7",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/observe": "^0.3.0",
    "@nestjs/platform-fastify": "^12.1.2",
    "@prisma/adapter-libsql": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@thallesp/nestjs-better-auth": "^2.8.0",
    "better-auth": "^1.7.7",
    "fastify": "^5.12.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "dotenv": "^18.0.6",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "prisma": "7",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
